{
  "name": "library-register-mysql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Library Entry & Exit Register running on MySQL",
  "main": "src/server.js",
  "scripts": {
    "setup": "node scripts/setup-db.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "exe": "esbuild src/server.js --bundle --platform=node --format=cjs --target=node20 --outfile=dist/bundle.cjs --log-level=warning && pkg dist/bundle.cjs --config pkg.config.json --targets node22-win-x64 --fallback-to-source --output dist/LibraryRegister.exe",
    "graph": "graphify extract . --code-only --no-viz --force && graphify cluster-only . --no-label",
    "graph:update": "graphify update . --no-cluster",
    "graph:report": "graphify cluster-only . --no-label",
    "deb": "bash scripts/build-deb.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "svg-captcha": "^1.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "db/**/*",
      "fonts/**/*",
      ".env.example"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2"
  }
}
